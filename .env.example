# Database: ideally the read-only fairness_scorer role (Fairness-Checker/ops/sql/create_scorer_readonly_role.sql)
AZURE_DB_URL=postgresql+psycopg://<user>:<password>@<server>.postgres.database.azure.com:5432/postgres?sslmode=require
# Shared with the gateway; at least 32 characters, e.g. `openssl rand -hex 32`
SCORER_API_KEY=

# Optional
TEAM_TIMEZONE=Asia/Kolkata
CACHE_TTL_SECONDS=60
LOG_LEVEL=INFO
LOG_FORMAT=text
